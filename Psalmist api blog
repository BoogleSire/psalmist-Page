  <button type="submit" class="btn btn-gold" style="width:100%">Submit for Review</button>
  <p id="submit-status" style="font-size:.8rem;margin-top:8px;color:var(--gold);display:none">Submission sent securely!</p>
</form>
<script>
//<![CDATA[
function handleSubmission(e) {
  e.preventDefault();
  const btn = e.target.querySelector('button');
  const status = document.getElementById('submit-status');
  const originalText = btn.innerText;
  
  btn.innerText = "Sending...";
  btn.disabled = true;

  // Simulate secure API call
  setTimeout(() => {
    btn.innerText = originalText;
    btn.disabled = false;
    status.style.display = 'block';
    e.target.reset();
    
    // Reset message after 3 seconds
    setTimeout(() => { status.style.display = 'none'; }, 3000);
  }, 1500);
}
//]]>
</script>
