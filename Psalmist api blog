<b:skin version='1.3.0'><![CDATA[
/*
<Group description="Colors">
  <Variable name="paper" description="Page background" type="color" default="#faf6ec" value="#faf6ec"/>
  <Variable name="ink" description="Text ink" type="color" default="#20213f" value="#20213f"/>
  <Variable name="gold" description="Gold accent" type="color" default="#D4AF37" value="#D4AF37"/>
  <Variable name="card" description="Card background" type="color" default="#fffdf6" value="#fffdf6"/>
</Group>
*/

:root{
  --paper:$(paper);
  --ink:$(ink);
  --gold:$(gold);
  --card:$(card);
  --muted:#6b6a80;
  --border:#e3dcc8;
  --accent:#f6e9c9;
  --radius:.35rem;
  --display:"Fraunces",Georgia,ui-serif,serif;
  --sans:"Karla",system-ui,-apple-system,sans-serif;
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
a:hover{text-decoration:underline;text-underline-offset:4px}
img{max-width:100%;height:auto;display:block}
h1,h2,h3,h4{font-family:var(--display);font-weight:600;letter-spacing:-.01em;margin:0}
.wrap{max-width:1100px;margin:0 auto;padding:0 16px}
.rule-gold{height:1px;width:5rem;background:linear-gradient(90deg,var(--gold),transparent);margin-top:.5rem}

/* Header */
.site-header{position:sticky;top:0;z-index:40;background:rgba(250,246,236,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--border)}
.header-inner{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;padding:16px}
.brand{font-family:var(--display);font-size:1.35rem;font-weight:600}
.brand span{color:var(--gold)}
.brand-desc{font-size:.8rem;color:var(--muted)}
.site-nav ul{display:flex;flex-wrap:wrap;gap:20px;margin:0;padding:0;list-style:none;font-size:.9rem}
.site-nav a{color:var(--muted)}
.site-nav a:hover{color:var(--ink)}

/* Layout */
.layout{display:grid;gap:48px;padding:48px 0}
@media (min-width:960px){.layout{grid-template-columns:minmax(0,1fr) 22rem}}

/* Posts */
.post{border-top:1px solid var(--border);padding-top:24px;margin-bottom:40px}
.post:first-child{border-top:0;padding-top:0}
.post-label{font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin:0 0 8px}
.post-title{font-size:1.6rem;line-height:1.25}
.index .post-title{font-size:1.35rem}
.item .post-title{font-size:2.2rem}
.post-meta{margin-top:10px;font-size:.78rem;color:var(--muted)}
.post-body{margin-top:16px}
.post-body p{margin:0 0 1.1em}
.post-body h2,.post-body h3{margin:1.6em 0 .5em}
.post-body blockquote{margin:1.4em 0;padding-left:16px;border-left:2px solid var(--gold);color:var(--muted);font-style:italic}
.post-body img{border-radius:var(--radius);margin:1.2em 0}
.readmore{display:inline-block;margin-top:12px;font-size:.85rem;font-weight:700;border-bottom:1px solid var(--gold)}
.readmore:hover{text-decoration:none}

/* Buttons & Forms */
.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:var(--radius);background:#2b2c55;color:#faf6ec;padding:10px 20px;font-size:.88rem;font-weight:700;border:none;cursor:pointer}
.btn:hover{opacity:.9;text-decoration:none}
.btn-gold{background:var(--gold);color:#fff}
.form-group{margin-bottom:12px}
.form-label{display:block;font-size:.8rem;font-weight:700;margin-bottom:4px;color:var(--muted)}
.form-input{width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:var(--radius);font-family:var(--sans);font-size:.9rem;background:#fff}
.form-input:focus{outline:2px solid var(--gold);border-color:transparent}

/* Sidebar */
.sidebar{display:flex;flex-direction:column;gap:24px}
@media (min-width:960px){.sidebar{position:sticky;top:96px;align-self:start}}
.card{border:1px solid var(--border);background:var(--card);border-radius:var(--radius);padding:20px}
.card.gold{border-color:rgba(212,175,55,.5);background:var(--accent)}
.card h2,.card h3{font-size:1.05rem}
.tools{list-style:none;margin:16px 0 0;padding:0;display:flex;flex-direction:column;gap:12px}
.tools a{display:block;border-radius:var(--radius);padding:8px}
.tools a:hover{background:var(--accent);text-decoration:none}
.tools strong{display:block;font-size:.88rem;line-height:1.3}
.tools small{display:block;color:var(--muted);font-size:.76rem}
.embed{margin-top:14px;border-radius:var(--radius);overflow:hidden;border:1px solid var(--border)}
.embed iframe{display:block;width:100%;border:0}
.widget ul{list-style:none;margin:12px 0 0;padding:0;font-size:.9rem;display:flex;flex-direction:column;gap:8px}
.widget .widget-item-control{display:none}

/* Feature Modules */
.module-tabs{display:flex;gap:8px;margin-bottom:12px;border-bottom:1px solid var(--border)}
.tab-btn{background:none;border:none;padding:8px 12px;font-size:.85rem;font-weight:600;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent}
.tab-btn.active{color:var(--gold);border-bottom-color:var(--gold)}
.tab-content{display:none}
.tab-content.active{display:block}
.result-box{background:#fff;border:1px solid var(--border);padding:12px;border-radius:var(--radius);margin-top:12px;font-size:.9rem;min-height:60px}

/* Footer */
.site-footer{margin-top:56px;border-top:1px solid var(--border)}
.footer-inner{padding:40px 16px;font-size:.85rem;color:var(--muted);max-width:1100px;margin:0 auto}
.footer-inner .brand{color:var(--ink);font-size:1.05rem}
.blog-pager{margin:32px 0;display:flex;justify-content:space-between;font-size:.88rem}
.status-msg-wrap{margin:24px 0;font-size:.9rem;color:var(--muted)}
]]></b:skin>
</head>

